<Page x:Class="ISIP323_Gusakov_WPF.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Gusakov_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Оформление заказа">
    <ScrollViewer Margin="10">
        <StackPanel >
            <TextBlock Text="ФИО" Margin="0,5"/>
            <TextBox x:Name="NameTextBox" Width="300"/>
            <TextBlock Text="Почта" Margin="0,5"/>
            <TextBox x:Name="EmailTextBox" Width="300"/>
            <TextBlock Text="Адрес" Margin="0,5"/>
            <TextBox x:Name="AddressTextBox" Width="300"/>
            <TextBlock Text="Ваш заказ:" Margin="0,10"/>
            <ItemsControl ItemsSource="{Binding CartItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text=" {Binding Product.Name} x {Binding Quantity} = {Binding TotalPrice ,StringFormat='{}{0:C}'}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TotalPrice,StringFormat='Общая цена: {0:C}'}" FontWeight="Bold" Margin="0,10"/>
            <Button Content="Заказать" Width="150" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</Page>
