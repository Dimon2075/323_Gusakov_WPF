<Window x:Class="ISIP323_Gusakov_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Gusakov_WPF"
        mc:Ignorable="d"
        Title="Онлайн магазин" Height="600" Width="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Каталог товара" Click="ShowCatalog"/>
            <Button Content="Корзина" Click="ShowCart" Margin="10,0"/>
            <Button Content="Оформление" Click="ShowOrder"/>
        </StackPanel>
        <Frame x:Name="MainFrame"/>
    </StackPanel>
</Window>
