<Page x:Class="ISIP323_Gusakov_WPF.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Gusakov_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Корзина">
    <StackPanel Margin="10">
        <ListView ItemsSource="{Binding CartItems}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" Width="200" DisplayMemberBinding="{Binding Product.Name}"/>
                    <GridViewColumn Header="Цена" Width="80" DisplayMemberBinding="{Binding Product.Price,StringFormat='{}{0:C}'}"/>
                    <GridViewColumn Header="Кол-во" Width="60" DisplayMemberBinding="{Binding Quantity}"/>
                    <GridViewColumn Header="Общая цена" Width="100" DisplayMemberBinding="{Binding TotalPrice,StringFormat='{}{0:C}'}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Text="{Binding TotalCartPrice,StringFormat='Итог: {0:C}'}" FontWeight="Bold" FontSize="14" Margin="0,10"/>
        <Button Content="Оформить заказ" Width="150" HorizontalAlignment="Center"/>
        <!--Click="Checkout"-->
    </StackPanel>
</Page>
